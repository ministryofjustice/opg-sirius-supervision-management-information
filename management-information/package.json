{
  "name": "opg-sirius-supervision-management-information",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "build": "yarn build:js && yarn build:css && yarn build:images",
    "build:js": "esbuild --bundle web/assets/main.js --minify --outfile=web/static/javascript/all.js --sourcemap --resolve-extensions=.mjs,.js",
    "build:css": "sass --load-path=node_modules --load-path=. --style compressed web/assets/main.scss web/static/stylesheets/all.css",
    "build:images": "mkdir -p web/static/assets/images && cp node_modules/govuk-frontend/dist/govuk/assets/images/* node_modules/@ministryofjustice/frontend/moj/assets/images/* web/static/assets/images",
    "clean": "rm -rf web/static",
    "test": "cd internal && go test",
    "cypress": "node_modules/.bin/cypress open",
    "cypress-ci": "node_modules/.bin/cypress open -c baseUrl=http://localhost:8080",
    "lint": "node_modules/.bin/eslint web/assets",
    "watch": "yarn build:css && yarn build:js --watch=forever"
  },

  "dependencies": {
    "@ministryofjustice/frontend": "^9.0.0",
    "govuk-frontend": "^6.0.0",
    "htmx.org": "^2.0.0",
    "opg-sirius-header": "ministryofjustice/opg-sirius-header#5c5151248e13b09f62ebce408e0346cae92e07a4"
  },
  "devDependencies": {
    "axe-core": "^4.9.1",
    "cypress": "^15.0.0",
    "cypress-axe": "^1.5.0",
    "cypress-failed-log": "^2.10.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^10.0.1",
    "sass": "^1.101.0",
    "typescript": "^6.0.0"
  }
}
