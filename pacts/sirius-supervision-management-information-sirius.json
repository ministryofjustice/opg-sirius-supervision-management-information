{
  "consumer": {
    "name": "sirius-supervision-management-information"
  },
  "interactions": [
    {
      "description": "A request for the bond providers list",
      "providerState": "Bond providers exist",
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/supervision-api/v1/bond-providers"
      },
      "response": {
        "body": [
          {
            "id": 1,
            "name": "Marsh"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body": {
            "match": "type",
            "min": 1
          },
          "$.body[*].id": {
            "match": "type"
          },
          "$.body[*].name": {
            "match": "type"
          }
        },
        "status": 200
      }
    },
    {
      "description": "A request for the current user",
      "providerState": "User exists",
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/supervision-api/v1/users/current"
      },
      "response": {
        "body": {
          "displayName": "Colin Case",
          "id": 1,
          "roles": [
            "Case Manager"
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.displayName": {
            "match": "type"
          },
          "$.body.id": {
            "match": "type"
          },
          "$.body.roles": {
            "match": "type",
            "min": 1
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-go": {
      "version": "dev"
    },
    "pactRust": {
      "ffi": "0.5.6",
      "mockserver": "2.2.5",
      "models": "1.3.14"
    },
    "pactSpecification": {
      "version": "2.0.0"
    }
  },
  "provider": {
    "name": "sirius"
  }
}